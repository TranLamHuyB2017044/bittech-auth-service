datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated-client"
}

model AuthLicense {
  id                String    @id @default(uuid()) @map("_id")
  public_id         String    @unique
  license_key       String    @unique
  signature         String?
  signature_version Int       @default(1)
  device_id         String?
  status            Int       @default(0)
  approved_at       DateTime?
  verified_at       DateTime?
  started_at        DateTime?
  expired_at        DateTime?
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("auth_licenses")
}

model AuthService {
  id               String   @id @default(uuid()) @map("_id")
  uuid             String?
  endpoint         String?
  connection_type  String?
  key              String   @unique
  key_encrypted    String?
  values           String
  values_encrypted String?
  user_id          String?
  app_name         String?
  app_info         String?
  dek_encrypted    String?
  data_iv          String?
  kek_version      Int      @default(1)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("auth_services")
}

model AuthLicenseAudit {
  id             String   @id @default(uuid()) @map("_id")
  action         String
  auditable_type String?
  auditable_id   String?
  causer_type    String?
  causer_id      String?
  properties     Json?
  ip_address     String?
  user_agent     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("auth_license_audits")
}
